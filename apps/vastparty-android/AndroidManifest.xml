<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vastparty.app"
    android:versionCode="3"
    android:versionName="1.2">

    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />
    <!-- Vast Family: shares (encrypted) family scores and rules with vast-apps.fly.dev -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Vast Party Games"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
