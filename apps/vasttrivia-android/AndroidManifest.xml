<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vasttrivia.app"
    android:versionCode="5"
    android:versionName="1.4">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />
    <!-- Vast Family: shares (encrypted) family scores and rules with vast-apps.fly.dev -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Vast Family: the other Vast apps on this phone (one-tap join, one name per phone) -->
    <queries>
        <package android:name="com.vastarcade.app" />
        <package android:name="com.vastparty.app" />
        <package android:name="com.pocketlibrary" />
    </queries>

    <application
        android:label="Vast Trivia"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Vast Family "this phone" record for the other Vast apps only (checked by package + signing key) -->
        <provider android:name=".VastPhone$Provider" android:authorities="com.vasttrivia.app.vastfamily" android:exported="true" />
    </application>
</manifest>
